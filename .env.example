NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service principal de Azure AD compartido, con acceso de lectura otorgado
# en cada workspace de Fabric de cliente (ver README, sección Fabric).
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret

# Solo la usan los jobs de servidor (el sync de Fabric) — nunca el
# navegador. Bypassea RLS, tratarla como un secreto real.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protege las rutas temporales /api/test-fabric y /api/test-supabase
# mientras probamos la conexión. Cualquier string al azar sirve.
TEST_ROUTE_SECRET=pick-any-random-string

# Connection string directo a Postgres (vía el connection pooler de
# Supabase, modo Session) — lo usan los reportes en /reportes/* para correr
# SQL con CTEs que el cliente REST de supabase-js no puede expresar.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:5432/postgres
