NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service principal de Azure AD compartido, con acceso de lectura otorgado
# en cada workspace de Fabric de cliente (ver README, sección Fabric).
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret

# Solo la usan los jobs de servidor (el sync de Fabric) — nunca el
# navegador. Bypassea RLS, tratarla como un secreto real.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protege las rutas temporales /api/test-fabric y /api/test-supabase
# mientras probamos la conexión. Cualquier string al azar sirve.
TEST_ROUTE_SECRET=pick-any-random-string

# Connection string directo a Postgres (vía el connection pooler de
# Supabase, modo Session) — lo usan los reportes en /reportes/* para correr
# SQL con CTEs que el cliente REST de supabase-js no puede expresar.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:5432/postgres

# Endpoint SQL y lakehouse de Fabric para el sync automático diario
# (scripts/sync-gold.ts, corre por GitHub Actions — ver
# .github/workflows/sync-gold.yml). Hoy es siempre el de Decathlon; si se
# suma otro cliente, este script necesita generalizarse.
#
# Estas 2 (y las de Azure/Supabase de arriba) NO van en las env vars de
# Vercel — el sync ya no corre ahí. Van como Secrets del repo en GitHub:
# Settings → Secrets and variables → Actions → New repository secret.
FABRIC_SQL_ENDPOINT=your-workspace.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=LH_Deca_Negocio

# Datos del recurso "Fabric capacity" en Azure (no de Fabric/Power BI). El
# sync los usa para despertarlo automáticamente si se pausó por inactividad
# antes de intentar conectar (ver lib/fabricCapacity.ts). El service
# principal de arriba necesita el rol "Contributor" sobre este recurso
# puntual (Azure Portal → el recurso → Control de acceso (IAM) → Add role
# assignment), si no esta llamada falla con error de autorización aunque
# las credenciales sean correctas.
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_FABRIC_RESOURCE_GROUP=your-resource-group
AZURE_FABRIC_CAPACITY_NAME=your-fabric-capacity-name

# Asistente de IA (/asistente, app/api/asistente/chat) — secrets de Vercel,
# no de GitHub Actions (esta ruta corre en el portal, no en el sync diario).
#
# Clave de la API de Claude (console.anthropic.com). El modelo usado es
# configurable con ANTHROPIC_CHAT_MODEL (opcional, tiene un default).
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5

# Connection string de solo lectura: MISMO host/puerto que SUPABASE_DB_URL
# de arriba, pero con el rol decathlon_readonly (usuario y contraseña
# distintos) en vez de postgres — ese rol solo tiene permiso de SELECT
# sobre las tablas gold_*, nunca puede escribir. No reusar SUPABASE_DB_URL
# acá: son conexiones a roles distintos a propósito.
SUPABASE_READONLY_DB_URL=postgresql://decathlon_readonly.your-project-ref:your-readonly-password@your-pooler-host:5432/postgres
